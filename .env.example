# ── Binance Testnet (paper/backtest mode) ──────────────────────────────────────
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here
BINANCE_TESTNET=true

# ── Alpaca Paper Trading ───────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_API_SECRET=your_alpaca_paper_api_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Live Trading Guard (BOTH must be true to enable live trading) ──────────────
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMED=false

# ── Risk / Sizing ──────────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=0.01
MAX_OPEN_POSITIONS=5
MAX_PORTFOLIO_RISK_PCT=0.05
INITIAL_CAPITAL=1000.0

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SLIPPAGE_PCT=0.001
COMMISSION_PCT=0.001
