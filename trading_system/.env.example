# ============================================================
# HALAL TRADING SYSTEM — ENVIRONMENT VARIABLES
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Binance ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Set to true to use Binance testnet (safe for paper trading)
BINANCE_TESTNET=true

# --- Alpaca (paper trading) ---
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
# Paper trading URL (default). Change to live URL only after gate approval.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Risk limits ---
BASE_RISK_PCT=0.01
MAX_POSITION_PCT=0.05
MAX_PORTFOLIO_EXPOSURE=0.25
MAX_CONCURRENT_TRADES=6
DAILY_LOSS_LIMIT_PCT=0.03
WEEKLY_LOSS_LIMIT_PCT=0.07
MAX_DRAWDOWN_PCT=0.15
CONSECUTIVE_LOSS_LIMIT=4

# --- ATR multipliers ---
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
ATR_TRAILING_MULTIPLIER=0.5
ATR_BREAKEVEN_TRIGGER=1.0

# --- Scoring thresholds ---
ENTRY_SCORE_MIN=60
ENTRY_CONFIDENCE_MIN=0.65
EARLY_MOMENTUM_SCORE_MIN=55

# --- Execution ---
SLIPPAGE_PCT=0.0005
COMMISSION_PCT=0.001
ORDER_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# --- Scan ---
SCAN_INTERVAL_MINUTES=15
PAPER_TRADE_GATE_MIN_TRADES=50

# --- LIVE TRADING GATES ---
# BOTH must be true for live trading. Default: false (paper only).
# Do NOT enable until LiveTradingGate criteria are all met.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMED=false
